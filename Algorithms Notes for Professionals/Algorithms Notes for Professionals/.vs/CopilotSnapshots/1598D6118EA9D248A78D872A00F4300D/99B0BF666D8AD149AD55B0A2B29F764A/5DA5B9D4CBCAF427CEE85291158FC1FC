using System;
using System.IO;
using System.Threading.Tasks;

static class Program
{
    public static void Main()
    {        
        int[] data = { 43, 27, 45, 24, 35};
        SelectionSort.Sort(data);
        Console.WriteLine("Sorted Array: " + string.Join(", ", data));
    }
    public class SelectionSort
    {
        // 1. Make Function using Synthesis
        public static void Sort(int[] input)
        {
            int n = input.Length; // Get the length of the array

            // Use iteration loop
            for (int i = 0; i < n - 1; i++)
            {
                int min_Id = i;

                // nested loop to find the minimum element in the unsorted part of the array
                for (int j = i + 1; j < n; j++)
                {
                    if (input[j] < input[min_Id])
                    {
                        min_Id = j;
                    }
                }
                // Swap the found minimum element with the first element
                int temp = input[min_Id];
                input[min_Id] = input[i];
                input[i] = temp;
            }
        }
    }
}

